APP_NAME=API Context Engine
APP_VERSION=0.1.0
APP_DESCRIPTION=AI-powered platform for understanding and interacting with API specifications

DATABASE_URL=sqlite:///./api_context_engine.db

DEBUG=True
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
