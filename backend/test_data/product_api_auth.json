{
  "openapi": "3.0.3",
  "info": {
    "title": "Product API Auth Test",
    "version": "1.0.0",
    "description": "Product API test specification with bearer authentication"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/products/{product_id}": {
      "post": {
        "summary": "Replace a product",
        "description": "Replaces an existing product.",
        "operationId": "replaceProduct",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 123
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Laptop"
                  },
                  "price": {
                    "type": "number",
                    "example": 999.99
                  },
                  "in_stock": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product replaced successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "example": 123
                    },
                    "name": {
                      "type": "string",
                      "example": "Laptop"
                    },
                    "price": {
                      "type": "number",
                      "example": 999.99
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid product data"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
