{
  "openapi": "3.0.3",
  "info": {
    "title": "E2E Product Inventory API V5",
    "version": "1.0.0",
    "description": "End-to-end integration test API for API Context Engine with documented server URL"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000"
    }
  ],
  "paths": {
    "/products/{product_id}": {
      "post": {
        "summary": "Replace a product",
        "description": "Replaces an existing product.",
        "operationId": "e2eReplaceProductV2",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "example": 123
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "price"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Keyboard"
                  },
                  "price": {
                    "type": "number",
                    "example": 49.99
                  },
                  "in_stock": {
                    "type": "boolean",
                    "example": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Product replaced successfully"
          },
          "400": {
            "description": "Invalid product data"
          },
          "404": {
            "description": "Product not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
